<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Nunca servir archivos de configuracion o herramientas del proyecto.
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|artisan|phpunit\.xml|server\.php|setup\.sh)$ - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Evita un bucle cuando Apache vuelve a procesar la reescritura interna.
    RewriteRule ^public(?:/|$) - [L]

    # El front controller real de Laravel vive en public/index.php.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
